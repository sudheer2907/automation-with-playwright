{
  "name": "automation-with-playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test; node update-test-results.js",
    "test:headed": "playwright test --headed; node update-test-results.js",
    "test:debug": "playwright test --debug",
    "test:qa": "cross-env ENV=qa playwright test; node update-test-results.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:serve": "allure serve allure-results",
    "test:with-allure": "playwright test; npm run allure:generate; node update-test-results.js",
    "report:html": "playwright show-report",
    "portal": "node server-debug.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.3"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "dotenv": "^17.2.3",
    "form-data": "^4.0.0"
  }
}
